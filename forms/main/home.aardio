import win.ui;
var winform = win.form(text="首页";right=959;bottom=591;bgcolor=16777215);
winform.add(
    title={cls="static";text="winXray";left=120;top=95;right=820;bottom=143;font=LOGFONT(h=-32);color=3947580;transparent=1;z=1};
    lbNode={cls="static";text="选择节点";left=120;top=178;right=820;bottom=204;font=LOGFONT(h=-15);transparent=1;z=2};
    nodes={cls="plus";text="点击选择节点";left=120;top=215;right=650;bottom=250;dr=1;align="left";bgcolor=16777215;border={color=13816530;radius=4};textPadding={left=12;right=12};notify=1;font=LOGFONT(h=-15);z=3};
    testLatency={cls="plus";text="测延时";left=665;top=215;right=820;bottom=250;dr=1;bgcolor=14935259;font=LOGFONT(h=-15);notify=1;z=10};
    latency={cls="static";text="TCP 延时：未测速";left=120;top=257;right=820;bottom=282;dr=1;font=LOGFONT(h=-13);transparent=1;z=11};
    smart={cls="radiobutton";text="智能分流模式";left=120;top=290;right=320;bottom=323;font=LOGFONT(h=-17);bgcolor=16777215;z=4};
    global={cls="radiobutton";text="全局模式";left=350;top=290;right=540;bottom=323;font=LOGFONT(h=-17);bgcolor=16777215;z=5};
    start={cls="plus";text="点我启动";left=120;top=365;right=820;bottom=420;dr=1;font=LOGFONT(h=-18);bgcolor=11580047;notify=1;z=6};
    stop={cls="plus";text="点我停止";left=120;top=365;right=820;bottom=420;dr=1;font=LOGFONT(h=-18);bgcolor=14935259;notify=1;hide=1;z=7};
    traffic={cls="static";text="剩余流量 / 总流量：订阅未提供";left=120;top=455;right=820;bottom=485;dr=1;font=LOGFONT(h=-15);transparent=1;z=8};
    expiry={cls="static";text="到期时间：订阅未提供";left=120;top=492;right=820;bottom=522;dr=1;font=LOGFONT(h=-15);transparent=1;z=9}
);
import config;
import web.json;
import v2ray.core;
import sysProxy;
import style;
winform.start.skin(style.primaryButton);
winform.stop.skin(style.button);
winform.testLatency.skin(style.button);
winform.nodes.skin(style.button);
var selectedNode;
var selectedHomeIndex = 0;
var nodePicker;
var preferredMode = config.proxy.mode == "proxy" ? "proxy" : "pac";
var signature;
var refreshing = false;
var connected = false;
var measuringLatency = false;
var latencyRequestToken = 0;
var latencyNode;
var updateControl = function(control,property,value){
    if(control[property] !== value) control[property] = value;
}
var rememberNode = function(node){
    if(!node) return;
    var saved = {protocol=node.protocol;address=node.address;port=tonumber(node.port);ps=node.ps;subscribeUrl=node.subscribeUrl};
    if(web.json.stringify(saved) != web.json.stringify(config.proxy.homeSelectedNode)){
        config.proxy.homeSelectedNode = saved;
        config.proxy.save();
    }
}
var matchesSavedNode = function(node,saved){
    return saved && node.protocol == saved.protocol && node.address == saved.address
        && tonumber(node.port) == tonumber(saved.port) && node.subscribeUrl == saved.subscribeUrl;
}
var formatBytes = function(bytes){
    var units = {"B";"KB";"MB";"GB";"TB"};
    var index = 1;
    while(bytes >= 1024 && index < #units){ bytes /= 1024; index++; }
    return string.format("%.2f %s",bytes,units[index]);
}

winform.refresh = function(){
    var labels = table.array();
    var selectedIndex;
    var rememberedIndex,endpointIndex;
    var saved = config.proxy.homeSelectedNode;
    for(i=1;#config.proxy.outbounds){
        var node = config.proxy.outbounds[i];
        var measured = mainForm.proxyController.listview.getItemText(i,7);
        table.push(labels,(node.ps : node.address : "节点") + "  ·  " + (node.protocol : "") + "  " + (node.address : "") + (measured ? "  [" + measured + "]" : ""));
        if(node === selectedNode) selectedIndex = i;
        if(matchesSavedNode(node,saved)){
            if(!endpointIndex) endpointIndex = i;
            if(node.ps == saved.ps && !rememberedIndex) rememberedIndex = i;
        }
    }
    var nextSignature = string.join(labels,"\n");
    if(nextSignature != signature || selectedNode !== config.proxy.outbounds[selectedHomeIndex]){
        refreshing = true;
        var controller = mainForm.proxyController;
        var nextIndex = selectedIndex : rememberedIndex : endpointIndex : (controller ? controller.listview.activeOutboundIndex) : (#labels ? 1 : 0);
        selectedHomeIndex = nextIndex;
        selectedNode = config.proxy.outbounds[selectedHomeIndex];
        refreshing = false;
        signature = nextSignature;
    }
    updateControl(winform.smart,"checked",preferredMode == "pac");
    updateControl(winform.global,"checked",preferredMode == "proxy");
    var controller = mainForm.proxyController;
    var starting = controller && (controller.autoTesting || controller.btnTcping.disabledText);
    updateControl(winform.start,"hide",connected);
    updateControl(winform.stop,"hide",!connected);
    updateControl(winform.start,"disabled",(!#labels || starting) ? true : false);
    updateControl(winform.start,"text",starting && !connected ? "正在启动…" : "点我启动");
    var node = config.proxy.outbounds[selectedHomeIndex];
    updateControl(winform.nodes,"text",node ? (node.ps : node.address) + "  ·  " + (node.protocol : "") + "   ▾" : "点击选择节点");
    updateControl(winform.nodes,"disabled",starting ? true : false);
    updateControl(winform.testLatency,"disabled",(!node || starting || measuringLatency) ? true : false);
    updateControl(winform.testLatency,"text",measuringLatency ? "测速中…" : "测延时");
    var speed = node ? controller.listview.getItemText(selectedHomeIndex,7);
    updateControl(winform.latency,"text","TCP 延时：" + (#speed ? speed : "未测速"));
    var info = node && node.subscribeUrl && config.proxy.subscriptionInfo ? config.proxy.subscriptionInfo[node.subscribeUrl];
    if(!info && node && node.subscribeUrl){
        var cache = web.json.tryParse(string.load(io.fullpath("/subscription-info.json")) : "{}");
        if(cache) info = cache[node.subscribeUrl];
    }
    var trafficText = "剩余流量 / 总流量：订阅未提供";
    var expiryText = "到期时间：订阅未提供";
    if(info){
        if(info.total !== null && info.upload !== null && info.download !== null){
            var remaining = info.total - info.upload - info.download;
            if(remaining < 0) remaining = 0;
            trafficText = "剩余流量 / 总流量：" + formatBytes(remaining) + " / " + formatBytes(info.total);
        }
        if(info.expire) expiryText = "到期时间：" + tostring(time(info.expire));
        elseif(info.expire === 0) expiryText = "到期时间：长期有效";
    }
    updateControl(winform.traffic,"text",trafficText);
    updateControl(winform.expiry,"text",expiryText);
}

var selectHomeNode = function(index){
    if(refreshing) return;
    if(!config.proxy.outbounds[index]) return;
    selectedHomeIndex = index;
    selectedNode = config.proxy.outbounds[selectedHomeIndex];
    rememberNode(selectedNode);
    mainForm.proxyController.listview.selIndex=index;
    mainForm.proxyController.listview.ensureVisible(index);
    if(selectedNode && v2ray.core.isRunning()) mainForm.proxyController.startNode(selectedHomeIndex);
    winform.refresh();
}
winform.nodes.oncommand = function(){
    if(nodePicker && win.isWindow(nodePicker.hwnd)){ nodePicker.show(); return; }
    var dialog = win.form(text="选择节点";right=760;bottom=470;border="dialog frame";max=false;parent=mainForm);
    nodePicker = dialog;
    dialog.add(
        search={cls="edit";left=18;top=18;right=510;bottom=48;edge=1;z=1};
        group={cls="combobox";left=525;top=18;right=742;bottom=48;mode="dropdown";edge=1;z=2};
        rows={cls="listview";left=18;top=62;right=742;bottom=397;edge=1;fullRow=1;gridLines=1;z=3};
        hint={cls="static";text="搜索名称、地址或协议；双击节点即可选择";left=18;top=417;right=402;bottom=445;transparent=1;z=4};
        measureAll={cls="button";text="测全部延时";left=412;top=412;right=542;bottom=447;z=7};
        choose={cls="button";text="选择节点";left=552;top=412;right=652;bottom=447;z=5};
        cancel={cls="button";text="取消";left=662;top=412;right=742;bottom=447;z=6}
    );
    dialog.search.setCueBannerText("搜索节点名称、地址或协议");
    dialog.rows.insertColumn("节点",245);
    dialog.rows.insertColumn("订阅分组",145);
    dialog.rows.insertColumn("协议",90);
    dialog.rows.insertColumn("延时",95);
    dialog.rows.insertColumn("状态",110);
    var groups={"全部订阅"};
    var groupUrls={"*"};
    var groupNames={};
    for(i=1;#config.proxy.outbounds){
        var node=config.proxy.outbounds[i];
        var url=node.subscribeUrl : "";
        if(!groupNames[url]){
            var name=url=="" ? "手动导入" : "订阅 " + #groups;
            for(j=1;#config.proxy.subscribeUrls){
                var sub=config.proxy.subscribeUrls[j];
                if(sub.url==url && #sub.ps) name=sub.ps;
            }
            groupNames[url]=name;table.push(groups,name);table.push(groupUrls,url);
        }
    }
    dialog.group.items=groups;dialog.group.selIndex=1;
    var displayed={};
    var batchToken=0;
    var batchActive=false;
    var batchNodes={};
    var batchCompleted=0;
    var renderRows=function(){
        var query=string.lower(string.trim(dialog.search.text));
        var group=groupUrls[dialog.group.selIndex] : "*";
        dialog.rows.clear();displayed={};
        for(i=1;#config.proxy.outbounds){
            var node=config.proxy.outbounds[i];
            var name=node.ps : node.address : "节点";
            var url=node.subscribeUrl : "";
            var searchable=string.lower(name + " " + (node.address : "") + " " + (node.protocol : ""));
            if((group=="*" || group==url) && (!#query || string.indexOf(searchable,query))){
                table.push(displayed,node);
                var status=i==selectedHomeIndex ? "当前选择" : "";
                dialog.rows.addItem({name;groupNames[url] : "订阅";node.protocol : "";mainForm.proxyController.listview.getItemText(i,7) : "未测速";status});
                if(i==selectedHomeIndex){ dialog.rows.setSelected(#displayed,true);dialog.rows.ensureVisible(#displayed); }
            }
        }
        dialog.choose.disabled=!#displayed;
        if(!#displayed) dialog.hint.text="没有匹配的节点，请调整搜索或分组。";
        else dialog.hint.text="找到 " + #displayed + " 个节点；双击节点即可选择";
    }
    dialog.search.oncommand=function(id,event){ if(event==0x300/*_EN_CHANGE*/) renderRows(); }
    dialog.group.onOk=renderRows;
    dialog.choose.oncommand=function(){
        var node=displayed[dialog.rows.selIndex];if(!node) return;
        var index;
        for(i=1;#config.proxy.outbounds){ if(config.proxy.outbounds[i]===node) index=i; }
        if(!index){ renderRows();return; }
        dialog.close();selectHomeNode(index);
    }
    dialog.rows.onDoubleClick=function(row){
        if(!displayed[row]) return;
        dialog.rows.selIndex=row;
        dialog.choose.oncommand();
    }
    dialog.isLatencyBatchActive=function(token){ return batchActive && token==batchToken; }
    dialog.onBatchLatency=function(token,slot,text){
        if(!batchActive || token!=batchToken) return;
        var node=batchNodes[slot];
        for(i=1;#config.proxy.outbounds){
            if(config.proxy.outbounds[i]===node){
                mainForm.proxyController.listview.setItemText(text,i,7);break;
            }
        }
        for(i=1;#displayed){
            if(displayed[i]===node){ dialog.rows.setItemText(text,i,4);break; }
        }
        batchCompleted++;
        dialog.measureAll.text="停止测速 " + batchCompleted + "/" + #batchNodes;
        if(batchCompleted==#batchNodes){ batchActive=false;dialog.measureAll.text="测全部延时"; }
        winform.refresh();
    }
    dialog.measureAll.oncommand=function(){
        if(batchActive){ batchActive=false;batchToken++;dialog.measureAll.text="测全部延时";return; }
        batchNodes={};batchCompleted=0;batchToken++;
        var partitions={{};{};{};{}};
        for(i=1;#config.proxy.outbounds){
            var node=config.proxy.outbounds[i];table.push(batchNodes,node);
            table.push(partitions[(i-1)%4+1],{slot=i;address=node.address;port=tonumber(node.port)});
        }
        if(!#batchNodes) return;
        batchActive=true;dialog.measureAll.text="停止测速 0/" + #batchNodes;
        for(i=1;4){
            if(!#partitions[i]) continue;
            thread.invoke(function(picker,token,tasks){
                import wsock.tcp.client;
                import time;
                for(j=1;#tasks){
                    if(!picker.isLatencyBatchActive(token)) return;
                    var task=tasks[j];
                    var result="TCP 超时/连接失败";
                    var client;
                    try{
                        var total=0;
                        var succeeded=true;
                        for(k=1;2){
                            client=wsock.tcp.client();
                            var startedTick=time.tick();
                            var ok=client.connectTimeout(task.address,task.port,1.5);
                            total+=time.tick()-startedTick;
                            client.close();client=null;
                            if(!ok){ succeeded=false;break; }
                        }
                        if(succeeded) result=math.round(total/2) + " 毫秒";
                    }
                    catch(e){ if(client) client.close();result="TCP 测速失败"; }
                    if(!picker.isLatencyBatchActive(token)) return;
                    picker.onBatchLatency(token,task.slot,result);
                }
            },dialog,batchToken,partitions[i]);
        }
    }
    dialog.cancel.oncommand=function(){ dialog.close(); }
    dialog.onClose=function(){ batchActive=false;batchToken++;if(nodePicker===dialog) nodePicker=null; }
    renderRows();dialog.enableDpiScaling();dialog.show();
}
winform.onLatencyMeasured = function(token,text){
    if(token != latencyRequestToken) return;
    measuringLatency = false;
    // Keep the original node in the UI thread; worker arguments are copied.
    var node = latencyNode;
    latencyNode = null;
    for(i=1;#config.proxy.outbounds){
        if(config.proxy.outbounds[i] === node){
            mainForm.proxyController.listview.setItemText(text,i,7);
            break;
        }
    }
    winform.refresh();
}
winform.testLatency.oncommand = function(){
    var node = config.proxy.outbounds[selectedHomeIndex];
    if(!node || measuringLatency) return;
    measuringLatency = true;
    latencyNode = node;
    latencyRequestToken++;
    winform.refresh();
    thread.invoke(function(home,token,address,port){
        import wsock.tcp.client;
        import time;
        var total = 0;
        for(i=1;2;1){
            var client = wsock.tcp.client();
            var latencyStartTick = time.tick();
            var connected = client.connectTimeout(address,port,1.5);
            total += time.tick() - latencyStartTick;
            client.close();
            if(!connected){ home.onLatencyMeasured(token,"TCP 超时/连接失败"); return; }
        }
        home.onLatencyMeasured(token,math.round(total / 2) + " 毫秒");
    },winform,latencyRequestToken,node.address,tonumber(node.port));
}
winform.smart.oncommand = function(){
    preferredMode = "pac";
    sysProxy.switchToPacMode();
    winform.refresh();
}
winform.global.oncommand = function(){
    preferredMode = "proxy";
    sysProxy.switchToGlobalMode();
    winform.refresh();
}
winform.start.oncommand = function(){
    var index = selectedHomeIndex;
    if(!config.proxy.outbounds[index]) return;
    rememberNode(config.proxy.outbounds[index]);
    sysProxy.setMode(preferredMode);
    mainForm.proxyController.startNode(index);
    winform.refresh();
}
winform.stop.oncommand = function(){
    mainForm.proxyController.stopNode();
    winform.refresh();
}
subscribe("sysProxy.modeChanged",function(mode){
    if(mode == "proxy" || mode == "pac") preferredMode = mode;
    winform.refresh();
});
subscribe("activeOutbound",function(address){
    connected = address ? true : false;
    if(connected){
        var index = mainForm.proxyController.listview.activeOutboundIndex;
        if(index){
            selectedHomeIndex = index;
            selectedNode = config.proxy.outbounds[index];
            rememberNode(selectedNode);
        }
    }
    winform.refresh();
});
subscribe("v2RayCore.stopped",function(){ connected = false; winform.refresh(); });
winform.refresh();
winform.setInterval(function(){ winform.refresh(); },1000);
winform.enableDpiScaling();
winform.show();
win.loopMessage();
return winform;
