            			"91.108.12.0/22"
					)
					
					winform.editPacProxy.text = web.json.stringify(proxy,true)
					winform.msgOk('已成功导入所有 Telegram IP\r\n下一步请点下面的「保存PAC」按钮。')
				}
				else {
					winform.msgWarn("代理 IP 段已包含所有 Telegram IP，不需要重复导入！")
				}
				
			}
		}; 
		{ /*分隔符*/ };
		{ "恢复内置网络规则（保留本地规则）";
