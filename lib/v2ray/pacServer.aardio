//pacServer 自动代理服务
import config;
import wsock.tcp.simpleHttpServer; 
import inet.http; 
import inet.url;

namespace v2ray.pacServer;
$serverMain = ..wsock.tcp.simpleHttpServer.mainThread( 
	function(response,request,session){ 

		if(request.path=="/proxy.pac"){ 
		 
			var pacData = ..string.load(pacPath);
			var proxPorts = inboundPort.get();
			if(!proxPorts[["socksProxy"]]){
				response.errorStatus(404);
				return;
			}
			
			var reps = ..string.replace(pacData,"var\s+proxy\s+=\s+%''","var proxy = 'SOCKS5 "+ request.environ.SERVER_NAME +":"+proxPorts.socksProxy 
				+";SOCKS "+ request.environ.SERVER_NAME +":"+proxPorts.socksProxy 
				+";PROXY "+ request.environ.SERVER_NAME +":"+proxPorts.httpProxy +"'"); 
				
			var useHttp = useHttpProxy.get();
			if(!useHttp){
				var ua = request.headers["user-agent"];
				if( ua && ..string.find(ua,"WinHttp-Autoproxy-Service/")){
					useHttp = true; 
				}
			}
			
			if(useHttp){
				reps = ..string.replace(pacData,"var\s+proxy\s+=\s+%''","var proxy = 'PROXY "+ request.environ.SERVER_NAME +":"+proxPorts.httpProxy +"'"); 
			}
	
			response.contentType = "application/x-ns-proxy-autoconfig";
			response.write(reps);
		}  
	} 	
);
$serverMain.threadNum = 50; 

var pacPath = ..io.appData("/winXray/pac.txt");
// Local overrides and downloaded rules are persisted independently.
import web.json;
var localPath = ..io.appData("/winXray/pac-local.json");
var networkPath = ..io.appData("/winXray/pac-network.json");

parseRules = function(text){
    var json = ..string.match(text,"var\s+rules\s*=\s*(%\[\])");
    var rules = json ? ..web.json.tryParse(json);
    if(!..table.isArray(rules) || !#rules) return;
    for(i,group in rules){
        if(!..table.isArray(group) || #group != 2) return;
        for(j,list in group){
            if(!..table.isArray(list)) return;
            for(k,rule in list){
                if(type(rule) != type.string || !#rule) return;
            }
        }
    }
    return rules;
}

loadNetworkRules = function(){
    var rules = ..web.json.tryParse(..string.load(networkPath) : "");
    return rules : parseRules($"/pac.txt");
}

loadLocalRules = function(){
    var rules = ..web.json.tryParse(..string.load(localPath) : "");
    return rules : {..table.array();..table.array()};
}

writeCombined = function(localRules,networkRules){
    var rules = {localRules};
    ..table.append(rules,networkRules);
    var str = ..string.replace($"/pac.txt","var\s+rules\s*=\s*%\[\]","var rules = " + ..web.json.stringify(rules,true));
    return ..string.save(pacPath,str);
}

// Keep the legacy PAC as a backup; preserve additions and direction overrides.
if(!..io.exist(localPath)){
    var legacyText = ..string.load(pacPath) : $"/pac.txt";
    var legacy = parseRules(legacyText) : parseRules($"/pac.txt");
    var defaults = parseRules($"/pac.txt");
    var localRules = {..table.array();..table.array()};
    for(i,group in legacy){
        for(j,list in group){
            for(k,rule in list){
                var found = false;
                for(n,base in defaults){
                    if(..table.indexOf(base[j],rule)) found = true;
                }
                if(!found && !..table.indexOf(localRules[j],rule)) ..table.push(localRules[j],rule);
            }
        }
    }
    if(..io.exist(pacPath)) ..string.save(..io.appData("/winXray/pac-legacy.txt"),legacyText);
    ..string.save(networkPath,..web.json.stringify(legacy,true));
    ..string.save(localPath,..web.json.stringify(localRules,true));
}

resetPac = function(){
    var rules = parseRules($"/pac.txt");
    if(!..string.save(networkPath,..web.json.stringify(rules,true))) return false;
    return writeCombined(loadLocalRules(),rules);
}

if(!..io.exist(pacPath)) writeCombined(loadLocalRules(),loadNetworkRules());

loadPacText = function(){
    return ..string.load(pacPath) : $"/pac.txt";
}

savePacText = function(json){
    var rules = parseRules("var rules = " + json);
    if(!rules || #rules != 1) return false;
    if(!..string.save(localPath,..web.json.stringify(rules[1],true))) return false;
    return writeCombined(rules[1],loadNetworkRules());
}

saveNetworkPac = function(text){
    var rules = parseRules(text);
    if(!rules) return false;
    if(!..string.save(networkPath,..web.json.stringify(rules,true))) return false;
    return writeCombined(loadLocalRules(),rules);
}

var inboundPort = ..thread.var();
var useHttpProxy = ..thread.var();
restart = function(){
	useHttpProxy.set(!..config.proxy.useSocksPac);

	$serverMain.threadGlobal = {
		inboundPort = inboundPort;
		pacPath = pacPath;
		useHttpProxy = useHttpProxy;
	}

	var pacPort = ..config.proxy.pacPort;
	if( (! pacPort) || pacPort >= 49152 ){ pacPort = ..wsock.tcp.server.getFreePort("127.0.0.1",1083,10803,10813,44823) }

	var currentIp,currentPort = $serverMain.getLocalIp(); 
	if(currentIp!==..config.core.default.inbounds[[1]][["listen"]] 
		|| currentPort != pacPort ){
		$serverMain.stop();
	
		var ok,err = $serverMain.start(
			..config.core.default.inbounds[[1]][["listen"]] : "127.0.0.1",pacPort );
		if(!ok){ 
			..publish("uiCommand.print","启动PAC服务器失败",err)
			return false,err;
		}
			
		..publish("uiCommand.print","PAC服务器已启动",getUrl())
		..publish("pacServer.restarted",pacPort);
	}
	
	return true;
} 

stop = function(){
	if($serverMain){
		$serverMain.stop();
	}
}

updateUseHttpProxy = function(httpProxy){
	useHttpProxy.set(httpProxy);
}

updateConfig = function(socksProxyPort,httpProxyPort){
	if(socksProxyPort && httpProxyPort){
		inboundPort.set( {socksProxy=socksProxyPort;httpProxy=httpProxyPort} );
	} 
}

..subscribe("v2RayCore.restarted",function(socksProxyPort,httpProxyPort){
	updateConfig(socksProxyPort,httpProxyPort);
} )

getUrl = function(localIp){
	var url = $serverMain.getUrl("/proxy.pac?" + ..time.tick() )
	if(!url){ return }
	
	var tUrl = ..inet.url.split(url);
	if(!localIp){
			tUrl.host = "127.0.0.1"
		}
	else {
		tUrl.host = ..wsock.tcp.client.getLocalIp("www.baidu.com");
	}

	return tostring(tUrl);
}

getPort = function(){
	var ip,port = $serverMain.getLocalIp();
	return port;
}


/**intellisense(v2ray.pacServer)
stop() = 停止PAC服务器
restart() = 重启PAC服务器
getUrl(.(localIp) = 返回PAC服务地址
getPort() = 返回PAC端口
updateConfig(.(socksProxyPort,httpProxPort) = 更新代理端口或PAC数据
resetPac() = 重置为默认PAC
end intellisense**/
