// Run this file in aardio from the repository root. No network is used.
import console;
import crypt;
import crypt.random;
import web.json;
import v2ray.outbounds;

var key = "+/8AAAAAAAAAAAAAAAAAAA==";
var methods = {"2022-blake3-aes-128-gcm";"2022-blake3-aes-256-gcm";"2022-blake3-chacha20-poly1305"};
for(i,method in methods){
    var length = i == 1 ? 16 : 32;
    var generated = crypt.encodeBin(crypt.random(length));
    assert(#crypt.decodeBin(generated) == length);
    var node = {protocol="shadowsocks";security=method;id=generated + ":" + generated;address="2001:db8::1";port=443;ps="SS 2022"};
    var link = v2ray.outbounds.exportSharedLinks({node});
    assert(string.indexOf(link, "ss://2022-"));
    assert(string.indexOf(link, "[2001:db8::1]:443"));
    var parsed = v2ray.outbounds.importFromString(link);
    assert(#parsed == 1);
    assert(parsed[1].security == method && parsed[1].id == node.id);
    assert(parsed[1].address == node.address && parsed[1].ps == node.ps);
}
var parsed = v2ray.outbounds.importFromString("ss://2022-blake3-aes-128-gcm:%2B%2F8AAAAAAAAAAAAAAAAAAA%3D%3D@example.com:443/#test");
assert(#parsed == 1 && parsed[1].id == key);
parsed = v2ray.outbounds.importFromString("ss://aes-128-gcm:+test@example.com:443");
assert(#parsed == 1 && parsed[1].id == "+test");
var legacy = "ss://" + crypt.encodeBin("aes-128-gcm:server:user@example.com:443");
parsed = v2ray.outbounds.importFromString(legacy);
assert(#parsed == 1 && parsed[1].security == "aes-128-gcm" && parsed[1].id == "server:user");

// Isolate configuration generation from persisted user settings.
import process.popen;
config={core={default=web.json.parse(string.load("/forms/main/config/coreConfigs/default.json"))}};
loadcodex(string.load("/lib/v2ray/core/singBoxJson.aardio"));
var nativeTemplate=table.clone(config.core.default);
// Rule downloads are not needed for these offline schema checks.
config.core.default.route={final="proxy"};
var core=io.exist("/WinXray/sing-box/sing-box.exe") : io.exist("/sing-box/sing-box.exe");
assert(core,"sing-box.exe not found");
var path=io.fullpath("/.local/protocol-test-config.json");
var base={address="example.com";port=443;id="00000000-0000-4000-8000-000000000001"};
var cases={
    {protocol="vless";tls="reality";publicKey="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAs";shortId="9ae17ec6245cd6b5";sni="www.example.com";flow="xtls-rprx-vision";network="tcp";type="tcp"};
    {protocol="vmess";security="auto";network="ws";path="/test";tls="tls"};
    {protocol="trojan";id="test-password";tls="tls"};
    {protocol="shadowsocks";security="2022-blake3-aes-128-gcm";id="AAAAAAAAAAAAAAAAAAAAAA==:AAAAAAAAAAAAAAAAAAAAAA=="};
    {protocol="http";user="test";password="secret"};
    {protocol="socks";user="test";password="secret"};
    {protocol="tuic";password="test-password"};
    {protocol="hysteria2";password="test-password"};
    {protocol="hysteria";password="test-password";up_mbps=10;down_mbps=50};
    {protocol="naive";user="test";password="secret"}
};
for(i,fields in cases){
    var node=table.clone(base);table.assign(node,fields);
    var saved,err=v2ray.core.singBoxJson.write(path,node,1080,1082);
    assert(saved,err);
    var json=web.json.parse(string.load(path));
    assert(json.inbounds[1].type=="socks" && json.inbounds[1].listen_port==1080);
    assert(json.inbounds[2].type=="http" && json.inbounds[2].listen_port==1082);
    assert(!json.inbounds[1].port && json.outbounds[1].type==node.protocol);
    if(node.protocol=="vless"){
        assert(json.outbounds[1].tls.reality.public_key==node.publicKey);
        assert(json.outbounds[1].tls.reality.short_id==node.shortId);
        assert(json.outbounds[1].flow==node.flow);
    }
    var checker=process.popen(core,{"check";"-c";path});assert(checker);
    var done,out,stderr,exitCode=checker.waitOne(10000);
    if(done) checker.close();else checker.terminate();
    assert(done && exitCode==0,string.concat(node.protocol," ",out,stderr));
}
var invalid,err=v2ray.core.singBoxJson.outboundConfig({protocol="ssr"});
assert(!invalid && err);
invalid,err=v2ray.core.singBoxJson.outboundConfig({protocol="vless";network="kcp"});
assert(!invalid && err);
var legacy={inbounds={{protocol="socks";tag="proxy";port=1080};{protocol="http";tag="http_proxy";port=1082}};outbounds={{tag="proxy"};{protocol="freedom";tag="direct"};{protocol="blackhole";tag="block"}};routing={rules={{ip={"geoip:cn";"geoip:private"};outboundTag="direct";type="field"};{domain={"geosite:cn"};outboundTag="direct";type="field"}}}};
var migrated,err=v2ray.core.singBoxJson.template(legacy);assert(migrated,err);
assert(migrated.inbounds[1].listen_port==1080);
assert(#migrated.route.rules==3 && #migrated.route.rule_set==2);
assert(migrated.route.rules[2].ip_is_private);
assert(migrated.route.rule_set[1].tag=="geoip-cn");
legacy.dns={servers={"1.1.1.1"}};
invalid,err=v2ray.core.singBoxJson.template(legacy);assert(!invalid && err);
console.log("sing-box protocol regression tests passed.");
console.pause();
